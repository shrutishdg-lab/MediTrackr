# ========================================================
# MediTrackr Environment Configuration Template
# Copy this file to .env and adjust variables as needed
# ========================================================

# Port for the web server to listen on (Default: 3000)
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=production

# Host binding ('0.0.0.0' for public/container interfaces)
HOST=0.0.0.0
