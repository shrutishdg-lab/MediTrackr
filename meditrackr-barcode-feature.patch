@@ -0,0 +1,21 @@
+// ========================================================
+// MediTrackr Demo Barcode Catalogue (IoT simulation)
+// --------------------------------------------------------
+// Sample data only. Barcodes and batch numbers are NOT real
+// manufacturer values. In production this would be replaced
+// by a GS1 / distributor master-data lookup.
+// ========================================================
+
+const CATALOG = [
+  { barcode: '8901234567890', name: 'Dolo 650 Tablet', composition: 'Paracetamol 650mg', manufacturer: 'Micro Labs Ltd', category: 'Analgesic / Antipyretic', batchNo: 'DEMO-DL650-26', expiryDate: '2028-12-31', mrp: 35, costPrice: 25, sellingPrice: 32, unitsPerStrip: 15 },
+  { barcode: '8901234567891', name: 'Augmentin 625 Duo Tablet', composition: 'Amoxicillin 500mg + Clavulanic Acid 125mg', manufacturer: 'GlaxoSmithKline Pharmaceuticals', category: 'Antibiotic', batchNo: 'DEMO-AUG625-26', expiryDate: '2028-10-31', mrp: 205, costPrice: 158, sellingPrice: 190, unitsPerStrip: 10 },
+  { barcode: '8901234567892', name: 'Pantocid 40 Tablet', composition: 'Pantoprazole Gastro-Resistant 40mg', manufacturer: 'Sun Pharma Laboratories', category: 'Antacid / PPI', batchNo: 'DEMO-PTC40-26', expiryDate: '2028-09-30', mrp: 170, costPrice: 120, sellingPrice: 155, unitsPerStrip: 15 },
+  { barcode: '8901234567893', name: 'Telma 40 Tablet', composition: 'Telmisartan IP 40mg', manufacturer: 'Glenmark Pharmaceuticals', category: 'Antihypertensive', batchNo: 'DEMO-TLM40-26', expiryDate: '2028-11-30', mrp: 225, costPrice: 168, sellingPrice: 205, unitsPerStrip: 15 }
+];
+
+function findByBarcode(code) {
+  const clean = String(code || '').trim();
+  return CATALOG.find(item => item.barcode === clean) || null;
+}
+
+module.exports = { CATALOG, findByBarcode };
diff --git a/iot/sketch.ino b/iot/sketch.ino
new file mode 100644
index 0000000..ced8b0d
--- /dev/null
+++ b/iot/sketch.ino
@@ -0,0 +1,172 @@
+// ============================================================
+// MediTrackr - ESP32 barcode scanner node (Wokwi simulation)
+//
+// Press the button  -> the ESP32 "scans" the next demo barcode and
+//                      POSTs it to MediTrackr (/api/barcode/scan).
+// LED               -> blinks twice = medicine matched,
+//                      one long pulse = barcode unknown / request failed.
+//
+// IMPORTANT: Wokwi runs in the cloud, so it can NOT reach
+// http://localhost:3000. Set SERVER_URL to a public address
+// (deployed Render/Railway URL, or an ngrok / cloudflared tunnel).
+// ============================================================
+
+#include <WiFi.h>
+#include <WiFiClientSecure.h>
+#include <HTTPClient.h>
+
+// ---- Edit these -------------------------------------------------
+const char* WIFI_SSID = "Wokwi-GUEST";   // Wokwi's built-in open network
+const char* WIFI_PASS = "";
+const int   WIFI_CHANNEL = 6;            // speeds up connection in Wokwi
+
+// Public URL of your MediTrackr server, NO trailing slash
+const char* SERVER_URL = "https://YOUR-PUBLIC-URL.example.com";
+const char* DEVICE_ID  = "wokwi-esp32";
+const char* DEVICE_KEY = "";             // only if you set DEVICE_KEY in .env
+
+// Match these to the pins used in your diagram.json
+const int LED_PIN    = 2;
+const int BUTTON_PIN = 4;                // button between this pin and GND
+// -----------------------------------------------------------------
+
+// Demo barcodes (same as barcodeCatalog.js on the server)
+const char* BARCODES[] = {
+  "8901234567890",
+  "8901234567891",
+  "8901234567892",
+  "8901234567893"
+};
+const int BARCODE_COUNT = sizeof(BARCODES) / sizeof(BARCODES[0]);
+int nextBarcode = 0;
+
+const char* wifiStatusName(wl_status_t s) {
+  switch (s) {
+    case WL_IDLE_STATUS:     return "IDLE";
+    case WL_NO_SSID_AVAIL:   return "NO_SSID_AVAIL (network not found)";
+    case WL_SCAN_COMPLETED:  return "SCAN_COMPLETED";
+    case WL_CONNECTED:       return "CONNECTED";
+    case WL_CONNECT_FAILED:  return "CONNECT_FAILED";
+    case WL_CONNECTION_LOST: return "CONNECTION_LOST";
+    case WL_DISCONNECTED:    return "DISCONNECTED";
+    default:                 return "UNKNOWN";
+  }
+}
+
+void blink(int times, int onMs, int offMs) {
+  for (int i = 0; i < times; i++) {
+    digitalWrite(LED_PIN, HIGH);
+    delay(onMs);
+    digitalWrite(LED_PIN, LOW);
+    delay(offMs);
+  }
+}
+
+bool connectWifi(unsigned long timeoutMs) {
+  WiFi.mode(WIFI_STA);
+  WiFi.disconnect(true);
+  delay(100);
+
+  Serial.printf("Connecting to %s ...\n", WIFI_SSID);
+  WiFi.begin(WIFI_SSID, WIFI_PASS, WIFI_CHANNEL);
+
+  unsigned long start = millis();
+  while (WiFi.status() != WL_CONNECTED && millis() - start < timeoutMs) {
+    delay(500);
+    Serial.printf("  status: %s\n", wifiStatusName(WiFi.status()));
+  }
+
+  if (WiFi.status() == WL_CONNECTED) {
+    Serial.print("WiFi connected, IP: ");
+    Serial.println(WiFi.localIP());
+    return true;
+  }
+  Serial.println("WiFi connect timed out.");
+  return false;
+}
+
+// Sends one barcode to MediTrackr. Returns true if the medicine matched.
+bool sendScan(const char* barcode) {
+  String url = String(SERVER_URL) + "/api/barcode/scan";
+  String body = String("{\"barcode\":\"") + barcode + "\",\"deviceId\":\"" + DEVICE_ID + "\"}";
+
+  WiFiClientSecure secureClient;
+  WiFiClient plainClient;
+  HTTPClient http;
+  http.setTimeout(15000);
+
+  bool began;
+  if (url.startsWith("https://")) {
+    secureClient.setInsecure();          // fine for a class demo; use certs in production
+    began = http.begin(secureClient, url);
+  } else {
+    began = http.begin(plainClient, url);
+  }
+  if (!began) {
+    Serial.println("http.begin() failed - check SERVER_URL");
+    return false;
+  }
+
+  http.addHeader("Content-Type", "application/json");
+  if (strlen(DEVICE_KEY) > 0) http.addHeader("x-device-key", DEVICE_KEY);
+
+  int code = http.POST(body);
+  Serial.printf("POST %s -> HTTP %d\n", url.c_str(), code);
+
+  bool matched = false;
+  if (code > 0) {
+    String resp = http.getString();
+    matched = resp.indexOf("\"matched\":true") >= 0;
+
+    // Pull the medicine name out without needing a JSON library
+    int n = resp.indexOf("\"name\":\"");
+    if (matched && n >= 0) {
+      n += 8;
+      int e = resp.indexOf("\"", n);
+      Serial.println("Identified: " + resp.substring(n, e));
+    } else if (!matched) {
+      Serial.println("Barcode not recognised by server.");
+    }
+  } else {
+    Serial.println(http.errorToString(code));
+  }
+
+  http.end();
+  return matched;
+}
+
+void setup() {
+  Serial.begin(115200);
+  pinMode(LED_PIN, OUTPUT);
+  pinMode(BUTTON_PIN, INPUT_PULLUP);
+
+  if (!connectWifi(20000)) {
+    Serial.println("Will retry when the button is pressed.");
+    blink(5, 100, 100);
+  } else {
+    blink(1, 300, 100);
+  }
+  Serial.println("Ready. Press the button to scan a medicine.");
+}
+
+void loop() {
+  if (digitalRead(BUTTON_PIN) == LOW) {     // pressed
+    delay(40);                              // debounce
+    if (digitalRead(BUTTON_PIN) == LOW) {
+      const char* code = BARCODES[nextBarcode];
+      nextBarcode = (nextBarcode + 1) % BARCODE_COUNT;
+      Serial.printf("\nScanning barcode %s\n", code);
+
+      if (WiFi.status() != WL_CONNECTED && !connectWifi(10000)) {
+        blink(1, 800, 100);
+      } else if (sendScan(code)) {
+        blink(2, 150, 150);                 // success
+      } else {
+        blink(1, 800, 100);                 // unknown barcode / failure
+      }
+
+      while (digitalRead(BUTTON_PIN) == LOW) delay(10);   // wait for release
+    }
+  }
+  delay(10);
+}
