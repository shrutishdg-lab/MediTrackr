 function toggleDarkMode() {
@@ -1135,3 +1141,163 @@ function reprintBill(billId) {
     openPrintModal(bill);
   }
 }
+
+
+// -------------------------------------------------------------
+// BARCODE SCANNER (IoT simulation + ESP32 live feed)
+// -------------------------------------------------------------
+function bcSetStatus(id, message, type) {
+  const el = document.getElementById(id);
+  if (!el) return;
+  const styles = {
+    ok: 'bg-emerald-50 text-emerald-700',
+    error: 'bg-red-50 text-red-700',
+    info: 'bg-blue-50 text-blue-700'
+  };
+  el.className = 'text-xs rounded-lg px-3 py-2 ' + (styles[type] || styles.info);
+  el.textContent = message;
+}
+
+function bcFormatDate(iso) {
+  return new Date(iso + 'T00:00:00').toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
+}
+
+function showScannedMedicine(med) {
+  state.scannedMedicine = med;
+  document.getElementById('bcEmpty').classList.add('hidden');
+  document.getElementById('bcDetails').classList.remove('hidden');
+  document.getElementById('bcName').textContent = med.name;
+  document.getElementById('bcComposition').textContent = med.composition;
+  document.getElementById('bcBarcode').textContent = med.barcode;
+  document.getElementById('bcBatch').textContent = med.batchNo;
+  document.getElementById('bcExpiry').textContent = bcFormatDate(med.expiryDate);
+  document.getElementById('bcMrp').textContent = '\u20B9' + Number(med.mrp).toFixed(2);
+  document.getElementById('bcQty').value = 10;
+  document.getElementById('bcAddBtn').disabled = false;
+  document.getElementById('bcSaveStatus').className = 'hidden';
+}
+
+function clearScannedMedicine() {
+  state.scannedMedicine = null;
+  document.getElementById('bcDetails').classList.add('hidden');
+  document.getElementById('bcEmpty').classList.remove('hidden');
+}
+
+function applyScanResult(scan, sourceLabel) {
+  document.getElementById('bcManualInput').value = scan.barcode;
+  if (scan.matched && scan.medicine) {
+    showScannedMedicine(scan.medicine);
+    bcSetStatus('bcStatus', 'Medicine matched successfully' + (sourceLabel ? ' (' + sourceLabel + ').' : '.'), 'ok');
+  } else {
+    clearScannedMedicine();
+    bcSetStatus('bcStatus', 'Barcode ' + scan.barcode + ' not found in the demo catalogue.', 'error');
+  }
+}
+
+async function simulateBarcodeScan() {
+  const btn = document.getElementById('bcSimulateBtn');
+  btn.disabled = true;
+  bcSetStatus('bcStatus', 'Scanning...', 'info');
+  try {
+    const res = await fetch('/api/barcode/scan', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ deviceId: 'web-ui' })
+    });
+    const data = await res.json();
+    if (!res.ok || !data.success) throw new Error(data.message || 'Scan failed.');
+    state.lastSeenScanId = data.scan.id;
+    applyScanResult(data.scan, 'simulated scan');
+  } catch (err) {
+    bcSetStatus('bcStatus', err.message || 'Scan failed.', 'error');
+  } finally {
+    btn.disabled = false;
+  }
+}
+
+async function lookupBarcodeManual(event) {
+  event.preventDefault();
+  const code = document.getElementById('bcManualInput').value.trim();
+  if (!code) return;
+  try {
+    const res = await fetch('/api/barcode/' + encodeURIComponent(code));
+    const data = await res.json();
+    if (!res.ok) {
+      clearScannedMedicine();
+      bcSetStatus('bcStatus', 'Barcode not found in the demo catalogue. Try one of the sample barcodes.', 'error');
+      return;
+    }
+    showScannedMedicine(data.medicine);
+    bcSetStatus('bcStatus', 'Medicine matched successfully.', 'ok');
+  } catch (err) {
+    bcSetStatus('bcStatus', 'Lookup failed. Is the server running?', 'error');
+  }
+}
+
+async function addScannedToInventory() {
+  const med = state.scannedMedicine;
+  if (!med) return;
+  const btn = document.getElementById('bcAddBtn');
+  const stockStrips = Number(document.getElementById('bcQty').value);
+  btn.disabled = true;
+  btn.textContent = 'Saving to inventory...';
+  try {
+    const res = await fetch('/api/barcode/' + encodeURIComponent(med.barcode) + '/add', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ stockStrips })
+    });
+    const data = await res.json();
+    if (!res.ok || data.success === false) throw new Error(data.message || 'Inventory save failed.');
+    bcSetStatus('bcSaveStatus', 'Saved. ' + med.name + ' \u00B7 batch ' + med.batchNo + ' is now in inventory.', 'ok');
+    loadInventory();
+    loadDashboard();
+  } catch (err) {
+    bcSetStatus('bcSaveStatus', err.message || 'Could not save this batch.', 'error');
+  } finally {
+    btn.disabled = false;
+    btn.textContent = 'Add batch to inventory';
+  }
+}
+
+// Poll for scans pushed by the ESP32 while the Barcode tab is open.
+async function pollLatestScan() {
+  try {
+    const res = await fetch('/api/barcode/latest');
+    const { scan } = await res.json();
+    const badge = document.getElementById('bcDeviceBadge');
+    if (!scan) return;
+
+    if (state.lastSeenScanId === null) {
+      // First poll after opening the tab: remember, don't replay old scans.
+      state.lastSeenScanId = scan.id;
+      return;
+    }
+    if (scan.id !== state.lastSeenScanId) {
+      state.lastSeenScanId = scan.id;
+      if (scan.deviceId !== 'web-ui') {
+        if (badge) {
+          badge.textContent = 'Device: ' + scan.deviceId + ' \u00B7 live';
+          badge.className = 'text-[11px] font-semibold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200';
+        }
+        applyScanResult(scan, 'from ' + scan.deviceId);
+      }
+    }
+  } catch (err) {
+    /* server briefly unreachable; try again on next tick */
+  }
+}
+
+function startBarcodePolling() {
+  if (state.barcodePoller) return;
+  state.lastSeenScanId = null;
+  pollLatestScan();
+  state.barcodePoller = setInterval(pollLatestScan, 2000);
+}
+
+function stopBarcodePolling() {
+  if (state.barcodePoller) {
+    clearInterval(state.barcodePoller);
+    state.barcodePoller = null;
+  }
+}
