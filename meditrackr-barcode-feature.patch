+// -------------------------------------------------------------
+// 3b. BARCODE INTAKE (IoT simulation + ESP32 device bridge)
+// -------------------------------------------------------------
+const barcodeCatalog = require('./barcodeCatalog');
+
+// Most recent scan received from an IoT device (ESP32) or the UI.
+// The web UI polls /api/barcode/latest to show device scans live.
+let latestScan = null;
+let scanCounter = 0;
+let simulateCursor = -1;
+
+function publicMedicine(item) {
+  return item ? { ...item } : null;
+}
+
+app.get('/api/barcode/catalog', (req, res) => {
+  res.json(barcodeCatalog.CATALOG.map(publicMedicine));
+});
+
+app.get('/api/barcode/latest', (req, res) => {
+  res.json({ scan: latestScan });
+});
+
+// Called by the ESP32 (or the UI's Simulate Scan button).
+// Body: { barcode?: string, deviceId?: string }
+// If no barcode is sent, the server simulates one by cycling the catalogue.
+app.post('/api/barcode/scan', (req, res) => {
+  const requiredKey = process.env.DEVICE_KEY;
+  if (requiredKey && req.get('x-device-key') !== requiredKey) {
+    return res.status(401).json({ success: false, message: 'Invalid device key' });
+  }
+
+  let code = req.body && req.body.barcode ? String(req.body.barcode).trim() : '';
+  if (!code) {
+    simulateCursor = (simulateCursor + 1) % barcodeCatalog.CATALOG.length;
+    code = barcodeCatalog.CATALOG[simulateCursor].barcode;
+  }
+
+  const medicine = barcodeCatalog.findByBarcode(code);
+  scanCounter += 1;
+  latestScan = {
+    id: scanCounter,
+    barcode: code,
+    deviceId: (req.body && req.body.deviceId) || 'web-ui',
+    receivedAt: new Date().toISOString(),
+    matched: !!medicine,
+    medicine: publicMedicine(medicine)
+  };
+
+  res.json({ success: true, scan: latestScan });
+});
+
+app.get('/api/barcode/:code', (req, res) => {
+  const medicine = barcodeCatalog.findByBarcode(req.params.code);
+  if (!medicine) {
+    return res.status(404).json({ success: false, message: 'Barcode not found in the demo catalogue' });
+  }
+  res.json({ success: true, medicine: publicMedicine(medicine) });
+});
+
+// Add a scanned medicine to inventory.
+// Existing medicine (same name) -> add a new batch. New medicine -> create it.
+app.post('/api/barcode/:code/add', (req, res) => {
+  const med = barcodeCatalog.findByBarcode(req.params.code);
+  if (!med) {
+    return res.status(404).json({ success: false, message: 'Barcode not found in the demo catalogue' });
+  }
+
+  const stockStrips = Number(req.body && req.body.stockStrips);
+  if (!Number.isInteger(stockStrips) || stockStrips < 1) {
+    return res.status(400).json({ success: false, message: 'Enter a valid quantity of at least 1 strip.' });
+  }
+
+  const batch = {
+    batchNo: med.batchNo,
+    expiryDate: med.expiryDate,
+    mrp: med.mrp,
+    costPrice: med.costPrice,
+    sellingPrice: med.sellingPrice,
+    stockStrips
+  };
+
+  const existing = db.getMedicines().find(m => m.name.trim().toLowerCase() === med.name.trim().toLowerCase());
+
+  if (existing) {
+    const duplicate = (existing.batches || []).some(b => String(b.batchNo).toLowerCase() === med.batchNo.toLowerCase());
+    if (duplicate) {
+      return res.status(409).json({ success: false, message: 'This batch is already in inventory. No duplicate was added.' });
+    }
+    const updated = db.addBatch(existing.id, batch);
+    return res.json({ success: true, created: false, medicine: updated });
+  }
+
+  const created = db.addMedicine({
+    name: med.name,
+    composition: med.composition,
+    manufacturer: med.manufacturer,
+    category: med.category,
+    gstRate: 12,
+    unitsPerStrip: med.unitsPerStrip,
+    batches: [{ ...batch, stockTablets: stockStrips * med.unitsPerStrip }]
+  });
+  res.json({ success: true, created: true, medicine: created });
+});
+
